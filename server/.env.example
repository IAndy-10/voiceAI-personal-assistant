# Conversation language: es (Chilean Spanish, default) | en
BOT_LANGUAGE=es

# LLM provider: ollama (default, local) | anthropic | openai | google | auto
# "auto" picks the first key found (Anthropic -> OpenAI -> Google), else local ollama.
LLM_PROVIDER=ollama

# API keys (only needed for the matching provider)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Optional model overrides
# Lighter/faster option: gemma3:1b (good English, weaker Spanish facts)
OLLAMA_MODEL=qwen3:4b-instruct
# Keep the model loaded between turns (Ollama default is 5m)
OLLAMA_KEEP_ALIVE=30m
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=low
# OPENAI_MODEL=
# GOOGLE_MODEL=
LLM_MAX_TOKENS=400

# Speech
WHISPER_MODEL=mlx-community/whisper-large-v3-turbo-q4
# Leave unset to use the default voice for BOT_LANGUAGE
# PIPER_VOICE=
